{
  "manifest_version": 3,
  "name": "VoidStonks AutoCopy",
  "version": "1.0.0",
  "description": "Copia los resultados del scanner de VoidStonks al portapapeles aunque el juego tenga el foco.",
  "permissions": ["offscreen", "clipboardWrite"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://edelaf01.github.io/*",
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}

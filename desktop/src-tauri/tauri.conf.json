{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoidStonks",
  "version": "2.7.0",
  "identifier": "com.voidstonks.desktop",
  "build": {
    "frontendDist": "../../deploy"
  },
  "app": {
    "windows": [
      {
        "title": "VoidStonks",
        "width": 1100,
        "height": 800,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Compañero de Warframe: reliquias, sets, rivens y mercado.",
    "longDescription": "VoidStonks empaquetado como app de escritorio: escaneo de inventario, seguimiento de sets y reliquias, tasación de rivens y precios de warframe.market."
  }
}

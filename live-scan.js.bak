/* js/live_scanner.js - DEBUG MODE ACTIVATED */
import { state } from "./state.js";
import { getPriceValue } from "./api.js";
import { showToast, getSlug } from "./ui.js";

// --- MODO DEBUG: Poner en true para ver logs detallados ---
const DEBUG_MODE = true;

let liveStream = null;
let scanInterval = null;
let isScanning = false;
let worker = null;
let isStartingSession = false;
let detectionLocked = false;

// CONFIGURACIÓN
const SCAN_RATE_MS = 3000;
const CAPTURE_FPS = 1;

// AJUSTE DE ZONA DE ESCANEO
// Bajamos un poco el inicio (0.35 -> 0.365) para evitar texto superior
const Y_PERCENT = 0.38;
const H_PERCENT = 0.05;

// MEMORIA
let virtualCanvas = null;
let vCtx = null;
let motionCanvas = null;
let motionCtx = null;
let lastFrameData = null;
let snapshotCanvas = null;
let snapshotCtx = null;

let allowedSuffixes = new Set();
const priceCache = new Map();

// --- LOGGING HELPER ---
function logDebug(...args) {
  if (DEBUG_MODE) console.log("🛠️ [DEBUG]:", ...args);
}

// --- ALGORITMO DE SIMILITUD (Fuzzy Match) ---
function getSimilarity(s1, s2) {
  let longer = s1;
  let shorter = s2;
  if (s1.length < s2.length) {
    longer = s2;
    shorter = s1;
  }
  const longerLength = longer.length;
  if (longerLength === 0) return 1.0;
  return (
    (longerLength - editDistance(longer, shorter)) / parseFloat(longerLength)
  );
}

function editDistance(s1, s2) {
  s1 = s1.toLowerCase();
  s2 = s2.toLowerCase();
  const costs = new Array();
  for (let i = 0; i <= s1.length; i++) {
    let lastValue = i;
    for (let j = 0; j <= s2.length; j++) {
      if (i == 0) costs[j] = j;
      else {
        if (j > 0) {
          let newValue = costs[j - 1];
          if (s1.charAt(i - 1) != s2.charAt(j - 1))
            newValue = Math.min(Math.min(newValue, lastValue), costs[j]) + 1;
          costs[j - 1] = lastValue;
          lastValue = newValue;
        }
      }
    }
    if (i > 0) costs[s2.length] = lastValue;
  }
  return costs[s2.length];
}

export async function startLiveSession() {
  if (isStartingSession) return;
  if (liveStream && liveStream.active) return;

  isStartingSession = true;

  const video = document.getElementById("live-video");
  const canvas = document.getElementById("live-canvas");
  const toggleBtn = document.getElementById("scanner-toggle");
  const drawer = document.getElementById("scanner-drawer");

  if (toggleBtn) {
    toggleBtn.classList.add("active");
    const label = toggleBtn.querySelector(".label");
    if (label) label.innerText = "STARTING...";
  }

  // Prepara listas...
  allowedSuffixes.clear();
  const manualSuffixes = [
    "BLUEPRINT",
    "HANDLE",
    "RECEIVER",
    "CHASSIS",
    "SYSTEMS",
    "NEUROPTICS",
    "CARAPACE",
    "CEREBRUM",
    "BLADE",
    "HILT",
    "LINK",
    "POUCH",
    "STARS",
    "FORMA",
    "STOCK",
    "GRIP",
    "STRING",
    "LIMBS",
    "BARREL",
    "PRIME",
  ];
  manualSuffixes.forEach((s) => allowedSuffixes.add(s));

  // Añadimos sufijos dinámicos de la DB
  const dbKeys = Object.keys(state.itemsDatabase || {});
  dbKeys.forEach((key) => {
    const parts = key.toUpperCase().trim().split(" ");
    const lastWord = parts.pop();
    if (lastWord && lastWord.length > 2 && isNaN(lastWord))
      allowedSuffixes.add(lastWord);
  });

  logDebug(`Base de datos cargada. Total Items: ${dbKeys.length}`);

  try {
    liveStream = await navigator.mediaDevices.getDisplayMedia({
      video: {
        cursor: "never",
        displaySurface: "window",
        frameRate: { ideal: CAPTURE_FPS, max: 10 },
      },
      audio: false,
    });

    video.srcObject = liveStream;
    await video.play();

    // Init Canvas
    if (!virtualCanvas) {
      virtualCanvas = document.createElement("canvas");
      vCtx = virtualCanvas.getContext("2d", { willReadFrequently: true });
    }
    if (!motionCanvas) {
      motionCanvas = document.createElement("canvas");
      motionCanvas.width = 32;
      motionCanvas.height = 32;
      motionCtx = motionCanvas.getContext("2d", { willReadFrequently: true });
    }
    if (!snapshotCanvas) {
      snapshotCanvas = document.createElement("canvas");
      snapshotCtx = snapshotCanvas.getContext("2d");
    }

    // Ajuste Visor (Estética)
    const vWidth = video.videoWidth || 1920;
    const vHeight = video.videoHeight || 1080;
    const aspectRatio = vWidth / vHeight;
    const drawerWidth = 360;
    const drawerHeight = drawerWidth / aspectRatio;

    if (drawer) {
      drawer.style.position = "absolute";
      drawer.style.top = "100%";
      drawer.style.right = "0";
      drawer.style.width = `${drawerWidth}px`;
      drawer.style.height = `${drawerHeight}px`;
      drawer.style.opacity = "1";
      drawer.classList.remove("closed");
      drawer.classList.add("open");
    }

    if (video && canvas) {
      video.style.opacity = "0";
      video.style.position = "absolute";
      canvas.classList.remove("hidden");
      canvas.style.width = "100%";
      canvas.style.height = "100%";
      canvas.style.objectFit = "contain";
      canvas.style.display = "block";
    }

    if (!worker && window.Tesseract) {
      worker = await Tesseract.createWorker();
      await worker.loadLanguage("eng");
      await worker.initialize("eng");
      await worker.setParameters({
        preserve_interword_spaces: "1",
        tessedit_char_whitelist:
          "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789- ",
        tessedit_pageseg_mode: "6",
      });
    }

    lastFrameData = null;
    startLoop();
    showToast("Escáner Activo (DEBUG MODE)");

    if (toggleBtn) {
      const label = toggleBtn.querySelector(".label");
      if (label) label.innerText = "ESCANER ACTIVO";
    }

    liveStream.getVideoTracks()[0].onended = () => stopLiveSession();
  } catch (e) {
    console.error(e);
    stopLiveSession();
  } finally {
    isStartingSession = false;
  }
}

export function stopLiveSession() {
  if (scanInterval) clearInterval(scanInterval);
  if (liveStream) {
    liveStream.getTracks().forEach((track) => track.stop());
    liveStream = null;
  }
  isScanning = false;
  lastFrameData = null;
  isStartingSession = false;

  const toggleBtn = document.getElementById("scanner-toggle");
  if (toggleBtn) {
    toggleBtn.classList.remove("active");
    const label = toggleBtn.querySelector(".label");
    if (label) label.innerText = "LIVE SCAN";
  }
  const debugPreview = document.getElementById("debug-ocr-preview");
  if (debugPreview) debugPreview.remove();
}

function startLoop() {
  if (scanInterval) clearInterval(scanInterval);
  scanInterval = setInterval(async () => {
    const modal = document.getElementById("scan-success-modal");
    if (isScanning || (modal && !modal.classList.contains("hidden"))) return;
    await processFrame();
  }, SCAN_RATE_MS);
}

async function processFrame() {
  isScanning = true;
  const video = document.getElementById("live-video");
  const canvas = document.getElementById("live-canvas");

  if (!video || video.videoWidth < 10) {
    isScanning = false;
    return;
  }

  // --- PREPARAR DEBUG CANVAS ---
  let debugOcrCanvas = document.getElementById("debug-ocr-preview");
  if (DEBUG_MODE && !debugOcrCanvas) {
    debugOcrCanvas = document.createElement("canvas");
    debugOcrCanvas.id = "debug-ocr-preview";
    debugOcrCanvas.style.cssText =
      "position:fixed; top:10px; right:10px; border:2px solid red; z-index:10000; background:black; width:400px;";
    document.body.appendChild(debugOcrCanvas);
  }

  const width = video.videoWidth;
  const height = video.videoHeight;
  const cropY = Math.floor(height * Y_PERCENT);
  const cropH = Math.floor(height * H_PERCENT);

  // 1. Visor normal
  canvas.width = width;
  canvas.height = height;
  const ctx = canvas.getContext("2d", { willReadFrequently: true });
  ctx.drawImage(video, 0, 0, width, height);
  drawScanOverlay(ctx, width, cropY, cropH);

  // 2. Procesamiento para OCR
  const scaleFactor = 3.0;
  const targetW = width * scaleFactor;
  const targetH = cropH * scaleFactor;

  if (virtualCanvas.width !== targetW) {
    virtualCanvas.width = targetW;
    virtualCanvas.height = targetH;
  }

  // APLICAR FILTROS
  vCtx.filter = "grayscale(100%) brightness(1.2) contrast(300%) invert(100%)";
  vCtx.drawImage(video, 0, cropY, width, cropH, 0, 0, targetW, targetH);
  vCtx.filter = "none";
  const imageData = vCtx.getImageData(0, 0, targetW, targetH);
  const data = imageData.data;
  for (let i = 0; i < data.length; i += 4) {
    // Si el pixel no es muy oscuro, lo volvemos blanco puro (255)
    const avg = (data[i] + data[i + 1] + data[i + 2]) / 3;
    const threshold = 120; // Ajusta este valor entre 100 y 150
    const val = avg > threshold ? 255 : 0;
    data[i] = data[i + 1] = data[i + 2] = val;
  }
  vCtx.putImageData(imageData, 0, 0);
  // ACTUALIZAR DEBUG DESPUÉS DEL FILTRO
  if (DEBUG_MODE && debugOcrCanvas) {
    debugOcrCanvas.width = targetW;
    debugOcrCanvas.height = targetH;
    debugOcrCanvas.getContext("2d").drawImage(virtualCanvas, 0, 0);
  }

  try {
    const {
      data: { text },
    } = await worker.recognize(virtualCanvas);

    if (DEBUG_MODE) console.log("RAW OCR OUTPUT:", text.replace(/\n/g, " "));

    const foundItems = parseTextForItems(text);

    if (foundItems.length >= 1 && !detectionLocked) {
      detectionLocked = true;

      // Lógica para abrir el modal (Snapshot y openScanModal)
      if (!snapshotCanvas) {
        snapshotCanvas = document.createElement("canvas");
        snapshotCtx = snapshotCanvas.getContext("2d");
      }
      snapshotCanvas.width = width;
      snapshotCanvas.height = height;
      snapshotCtx.drawImage(video, 0, 0, width, height);
      openScanModal(snapshotCanvas.toDataURL("image/jpeg", 0.85), foundItems);
    }
  } catch (e) {
    console.error("OCR Error:", e);
  }

  isScanning = false;
}

function hasScreenChanged(newData, oldData) {
  if (!oldData) return true;
  let diff = 0;
  for (let i = 0; i < newData.length; i += 4) {
    diff += Math.abs(newData[i] - oldData[i]);
    if (diff > 5000) return true;
  }
  return false;
}

function drawScanOverlay(ctx, width, y, h) {
  ctx.fillStyle = "rgba(255, 0, 68, 0.15)";
  ctx.fillRect(0, y, width, h);
  ctx.lineWidth = 6;
  ctx.strokeStyle = "#ff0044";
  ctx.strokeRect(0, y, width, h);
  ctx.fillStyle = "#ff0044";
  ctx.font = "bold 40px Arial";
  ctx.fillText("ZONE (DEBUG)", 20, y - 10);
}

async function openScanModal(imageUrl, items) {
  const modal = document.getElementById("scan-success-modal");
  const imgEl = document.getElementById("scan-snapshot");
  const badgesContainer = document.getElementById("scan-badges-container");
  if (!modal || !imgEl || !badgesContainer) return;

  imgEl.src = imageUrl;
  badgesContainer.innerHTML = "";
  modal.classList.remove("hidden");

  items.forEach(async (item, index) => {
    let price = 0;
    if (priceCache.has(item.name)) price = priceCache.get(item.name);
    else {
      try {
        const slug = getSlug(item.name);
        price = await getPriceValue(item.name, slug);
        if (price > 0) priceCache.set(item.name, price);
      } catch (e) {}
    }
    createModalBadge(item.name, price, badgesContainer, index, items.length);
  });
}

function createModalBadge(name, price, container, index, total) {
  const badge = document.createElement("div");
  badge.className = "modal-badge";
  const leftPercent = ((index + 1) / (total + 1)) * 100;
  badge.style.left = `${leftPercent}%`;
  const slug = getSlug(name);
  const marketUrl = `https://warframe.market/items/${slug}`;

  badge.innerHTML = `
    <a href="${marketUrl}" target="_blank" style="text-decoration:none; color:inherit;">
        <div style="font-size:0.65em; color:#bbb; text-transform:uppercase; margin-bottom:4px; line-height:1.2; white-space:normal; overflow:visible; text-align:center; min-height:2.4em; display:flex; align-items:center; justify-content:center;">
            ${name}
        </div>
        <div style="font-size:1.2em; font-weight:800; color:#fff;">
            ${
              price > 0 ? price : "--"
            } <span style="font-size:0.6em; color:#00e5ff;">PL</span>
        </div>
    </a>`;
  container.appendChild(badge);
}

window.closeScanModal = function () {
  const modal = document.getElementById("scan-success-modal");
  if (modal) modal.classList.add("hidden");
  detectionLocked = false;
};

function parseTextForItems(rawText) {
  if (!rawText || !state.itemsDatabase) return [];

  // 1. Limpieza y Normalización
  let cleanText = rawText.toUpperCase()
    .replace(/[^A-Z]/g, " ")
    .replace(/\s+/g, " ")
    .trim();

  // Separar palabras pegadas (LAVOSPRIME -> LAVOS PRIME)
  cleanText = cleanText.replace(/([A-Z]+)(PRIME)/g, "$1 $2");
  cleanText = cleanText.replace(/(PRIME)(CHASSIS|SYSTEMS|NEUROPTICS|BARREL|RECEIVER|BLUEPRINT|STOCK|GRIP|LINK)/g, "$1 $2");

  const ocrWords = cleanText.split(" ").filter(w => w.length > 0);
  
  // Ordenar DB por número de palabras (más largos primero) para evitar coincidencias parciales
  const dbKeys = Object.keys(state.itemsDatabase).sort((a, b) => {
    const lenA = a.split(" ").length;
    const lenB = b.split(" ").length;
    return lenB - lenA;
  });

  const finalResults = [];
  const usedIndices = new Set();

  /**
   * Lógica de búsqueda con límite de distancia variable
   */
  function runMatchingPass(lookAheadLimit) {
    for (let i = 0; i < ocrWords.length; i++) {
      if (usedIndices.has(i) || finalResults.length >= 4) continue;

      for (const itemName of dbKeys) {
        const itemWords = itemName.toUpperCase().split(" ");
        const firstWord = itemWords[0];

        // ¿La palabra actual coincide con el inicio de un ítem?
        if (ocrWords[i] === firstWord || getSimilarity(ocrWords[i], firstWord) > 0.85) {
          let matchedIndices = [i];
          let currentPos = i;
          let possibleMatch = true;

          for (let j = 1; j < itemWords.length; j++) {
            let foundNext = false;
            // Buscamos la siguiente palabra del ítem dentro del rango permitido
            for (let dist = 1; dist <= lookAheadLimit; dist++) {
              const nextIdx = currentPos + dist;
              if (nextIdx < ocrWords.length && !usedIndices.has(nextIdx)) {
                if (ocrWords[nextIdx] === itemWords[j] || getSimilarity(ocrWords[nextIdx], itemWords[j]) > 0.85) {
                  matchedIndices.push(nextIdx);
                  currentPos = nextIdx;
                  foundNext = true;
                  break;
                }
              }
            }
            if (!foundNext) {
              possibleMatch = false;
              break;
            }
          }

          if (possibleMatch && matchedIndices.length === itemWords.length) {
            finalResults.push({ name: itemName, score: 1.0 });
            matchedIndices.forEach(idx => usedIndices.add(idx));
            break; // Pasamos a la siguiente palabra del OCR
          }
        }
      }
    }
  }

  // PASO 1: Capturar ítems en una sola línea (rango corto: 3 palabras)
  runMatchingPass(3);

  // PASO 2: Capturar ítems divididos en dos líneas (rango largo: 25 palabras)
  // Solo se ejecuta si aún no hemos encontrado las 4 recompensas
  if (finalResults.length < 4) {
    runMatchingPass(25);
  }

  return finalResults;
}
window.startLiveSession = startLiveSession;
window.stopLiveSession = stopLiveSession;

# Cabeceras de caché para Cloudflare Pages.
#
# El problema que resuelve: por defecto Pages sirve todo con max-age=14400 (4h). Tras un
# despliegue, quien tuviera la app abierta seguía ejecutando el JS anterior durante horas,
# y los síntomas parecían bugs nuevos (contadores parados, estilos a medias) cuando en
# realidad era código viejo mezclado con HTML nuevo.
#
# La regla: el HTML nunca se cachea, porque es quien nombra las versiones de todo lo demás.
# Si el HTML está fresco, sus ?v=<sha> apuntan al build actual y el navegador descarga lo
# que haya cambiado. Los .js/.css llevan TTL corto como red de seguridad (si el ?v= fallara,
# el desfase dura minutos y no horas).

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Los módulos y hojas llevan ?v=<sha-del-commit> reescrito por build-dist.mjs en CI, así que
# una URL concreta es inmutable en la práctica. El TTL corto cubre el caso de que algún
# import se quede sin versionar.
/js/*
  Cache-Control: public, max-age=300, must-revalidate

/css/*
  Cache-Control: public, max-age=300, must-revalidate

/styles.css
  Cache-Control: public, max-age=300, must-revalidate

# Imágenes: su contenido no cambia sin cambiar de nombre. Un año, y que el navegador no vuelva
# a preguntar.
#
# Por extensión y no `/assets/*`: Pages APLICA TODAS las reglas que casan y CONCATENA sus
# valores, no gana la más específica. Con la regla ancha, curiosidades.json salía con
# `max-age=31536000, immutable, max-age=3600, must-revalidate` en la misma cabecera —el año
# manda— y el visitante recurrente se quedaba con las curiosidades del día que entró por
# primera vez. El splat cruza carpetas, así que esto cubre también assets/relic_contents/.
/assets/*.webp
  Cache-Control: public, max-age=31536000, immutable

/assets/*.png
  Cache-Control: public, max-age=31536000, immutable

/assets/*.svg
  Cache-Control: public, max-age=31536000, immutable

# Modelos de OCR: 6 MB que no cambian nunca para un nombre dado (la versión va en el fichero).
/assets/*.ort
  Cache-Control: public, max-age=31536000, immutable

# Datos de la app (catálogos, JSON generados): cambian con los despliegues pero no son
# críticos al segundo. Una hora, revalidando.
/assets/json/*
  Cache-Control: public, max-age=3600, must-revalidate

# assets/ml/ NO es contenido inmutable: curiosidades.json lo reescribe el bot cada día y el
# bundle del modelo cambia con el reentreno de los lunes.
/assets/ml/*
  Cache-Control: public, max-age=3600, must-revalidate

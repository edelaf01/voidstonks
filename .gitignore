# scripts-actu ignorado SALVO lo que necesita el workflow retrain-ml.yml en CI
# (regla /dir a secas impediría re-incluir hijos; por eso /dir/* + negaciones)
/scripts-actu/*
# build-dist.mjs lo necesita el workflow deploy.yml en CI (minifica deploy/ -> dist/).
!/scripts-actu/build-dist.mjs
!/scripts-actu/ML-rivenvaluation/
/scripts-actu/ML-rivenvaluation/*
# Re-incluir SOLO los scripts .py (los que necesita retrain-ml.yml en CI). El .venv,
# exp_matrix.pkl, *.json y demás pesados siguen ignorados (solo se un-ignora *.py directo).
!/scripts-actu/ML-rivenvaluation/*.py
# Log de progreso del reentreno (una entrada por run): debe persistir en el repo para acumular
# histórico; el workflow retrain-ml.yml lo commitea.
!/scripts-actu/ML-rivenvaluation/metrics_history.json

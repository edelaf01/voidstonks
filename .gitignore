# scripts-actu ignorado SALVO lo que necesita el workflow retrain-ml.yml en CI
# (regla /dir a secas impediría re-incluir hijos; por eso /dir/* + negaciones)
/scripts-actu/*
# build-dist.mjs lo necesita el workflow deploy.yml en CI (minifica deploy/ -> dist/).
!/scripts-actu/build-dist.mjs
!/scripts-actu/ML-rivenvaluation/
/scripts-actu/ML-rivenvaluation/*
# Re-incluir SOLO los scripts .py (los que necesita retrain-ml.yml en CI). El .venv,
# exp_matrix.pkl, *.json y demás pesados siguen ignorados (solo se un-ignora *.py directo).
!/scripts-actu/ML-rivenvaluation/*.py
# Log de progreso del reentreno (una entrada por run): debe persistir en el repo para acumular
# histórico; el workflow retrain-ml.yml lo commitea.
!/scripts-actu/ML-rivenvaluation/metrics_history.json
scripts-actu/img/
# tests/ SÍ se versiona: las reglas de ARCHITECTURE.md solo sirven si el test que las
# comprueba viaja con el repo. Fuera quedan los volcados de depuración sueltos, que no los
# usa ningún test (1,7 MB). El fixture de _fixtures/ sí entra: lo necesitan 3 tests de OCR.
tests/_debug_user*.png
deploy/rootCA.crt
/.codebase-memory
deploy/rootCA.pem
certs/dev-key.pem
certs/dev.pem
# El package.json de la raíz se versiona junto con tests/: sin él no viajan `npm test`,
# `npm run lint` ni `npm run baseline:arquitectura`, y las reglas se quedan sin forma de
# ejecutarse en otra máquina. (El de desktop/ siempre estuvo dentro: lo necesita el build de Tauri.)
dist/
node_modules/
wf-parser.js

# Documentación y notas: ni la app, ni los tests ni los workflows leen ningún .md (los que citan
# los tests son comentarios; appraisal_results.md y model_comparison.md los genera el código).
*.md
!README.md

# Lo reescribe tests/appraisal-comparison.test.mjs en cada `npm test`.
tests/appraisal_results.json

# Sueltos de la raíz que no usa nadie: la app y los tests leen deploy/js/eng.traineddata, y el
# parser de EE.log de la app vive en deploy/js.
/eng.traineddata
/ee-log-*.js
/data/
/informes5/
/extension.crx
